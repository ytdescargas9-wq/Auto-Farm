-- 4. FLING AL MORIR (ON DEATH)
local function setupFlingOnDeath(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 5)
    
    if humanoid then
        humanoid.Died:Connect(function()
            pcall(function()
                local murderRoot = nil
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        if plr.Backpack:FindFirstChild("Knife") or plr.Character:FindFirstChild("Knife") then
                            murderRoot = plr.Character.HumanoidRootPart
                            break
                        end
                    end
                end

                local myRoot = character:FindFirstChild("HumanoidRootPart")
                if murderRoot and myRoot then
                    local bodyVel = Instance.new("BodyVelocity")
                    bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bodyVel.Velocity = Vector3.new(99999, 99999, 99999)
                    bodyVel.Parent = myRoot

                    local startFling = tick()
                    while tick() - startFling < 0.8 do
                        myRoot.CFrame = murderRoot.CFrame
                        task.wait()
                    end
                    bodyVel:Destroy()
                end
            end)
        end)
    end
end

if LocalPlayer.Character then setupFlingOnDeath(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupFlingOnDeath)

