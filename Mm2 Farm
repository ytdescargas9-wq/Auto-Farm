end)

-- 10. AUTO-FARM CON MANIQUÍ FALSO Y RESTRICCIÓN DE DISTANCIA/MAPA
local function createFakeBody(char)
    if fakeCharacter then fakeCharacter:Destroy() end
    char.Archivable = true
    fakeCharacter = char:Clone()
    fakeCharacter.Name = "FakeMannequin"
    fakeCharacter.Parent = Workspace
    
    for _, part in pairs(fakeCharacter:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
        end
    end
end

local function getCoins()
    local coins = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "CoinServer" or obj.Name == "CoinContainer" or obj.Name == "Coin" or obj.Name == "CoinVisual" then
            if obj:IsA("BasePart") and obj.Transparency < 1 then
                table.insert(coins, obj)
            elseif obj:IsA("Model") or obj:IsA("Folder") then
                for _, child in pairs(obj:GetChildren()) do
                    if child:IsA("BasePart") and child.Transparency < 1 then
                        table.insert(coins, child)
                    end
                end
            end
        end
    end
    return coins
end

task.spawn(function()
    while true do
        if autoFarmActive then
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                
                if not startPosition then
                    startPosition = rootPart.Position
                end

                if not fakeCharacter then
                    createFakeBody(character)
                end

                local coins = getCoins()
                if #coins > 0 then
                    for i = 1, #coins do
                        if not autoFarmActive then break end
                        local coin = coins[i]
                        if coin and coin.Parent then
                            -- RESTRICCIÓN: Validar que la moneda no esté demasiado lejos del punto de inicio (fuera del mapa)
                            local distFromStart = (coin.Position - startPosition).Magnitude
                            if distFromStart <= maxFarmDistance then
                                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                
                                local targetCFrameUnder = coin.CFrame + undergroundOffset
                                local distance = (rootPart.Position - targetCFrameUnder.Position).Magnitude
                                local travelTime = math.clamp(distance / farmSpeed, 0.2, 0.8)
                                
                                local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                                local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrameUnder})
                                tween:Play()
                                tween.Completed:Wait()

                                pcall(function()
                                    if firetouchinterest then
                                        firetouchinterest(rootPart, coin, 0)
                                        task.wait(0.05)
                                        firetouchinterest(rootPart, coin, 1)
                                    end
                                end)

                                local targetCFrameSurface = coin.CFrame
                                local upTween = TweenService:Create(rootPart, TweenInfo.new(0.15, Enum.EasingStyle.Linear), {CFrame = targetCFrameSurface})
                                upTween:Play()
                                upTween.Completed:Wait()

                                task.wait(0.1)
                            end
                        end
                    end
                end
            end
        else
            if fakeCharacter then
                fakeCharacter:Destroy()
                fakeCharacter = nil
            end
            startPosition = nil
        end
        task.wait(0.5)
    end
end)
